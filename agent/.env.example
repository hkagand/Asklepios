# Copy to agent/.env (git-ignored) and fill in.
# Any OpenAI-compatible chat completions endpoint with tool calling: vLLM, a LiteLLM proxy, ...
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=big_llm
# Optional, for reasoning models such as gpt-oss: low | medium | high
LLM_REASONING_EFFORT=low
FHIR_BASE_URL=http://localhost:8080/fhir
# Optional, for demos: treat this day (YYYY-MM-DD, the cohort's anchor) as today
# AGENT_TODAY=2026-10-23
# Optional, for demos on the synthetic data only: a "Reset demo" button that puts the FHIR server and the agent back to
# the data as loaded (demo.py). Refused when the server holds patients not marked synthetic.
# AGENT_DEMO_RESET=1
# Optional, experimental: a second, clinical model for considerations during a visit (considerations.py), e.g.
# MedGemma on a local Ollama. Off unless both are set.
# CLINICAL_LLM_BASE_URL=http://localhost:11434/v1
# CLINICAL_LLM_MODEL=medgemma1.5:4b
